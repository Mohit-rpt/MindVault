# -----------------------------------------------------------------------------
# MindVault Environment Configuration Template
# Copy this file to .env and adjust variables for your local setup.
# -----------------------------------------------------------------------------

# Environment & Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL + pgvector)
POSTGRES_USER=mindvault
POSTGRES_PASSWORD=mindvault_dev_password
POSTGRES_DB=mindvault
POSTGRES_PORT=5432
DATABASE_URL=postgresql://mindvault:mindvault_dev_password@localhost:5432/mindvault?schema=public

# Cache & Queues (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Worker Configuration
WORKER_CONCURRENCY=5

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:4000/api
