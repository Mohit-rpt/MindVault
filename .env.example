# -----------------------------------------------------------------------------
# MindVault — Environment Configuration Template
# Copy this file to .env and adjust variables for your local setup.
# -----------------------------------------------------------------------------

# =============================================================================
# 1. Environment & Server Gateway
# =============================================================================
# Node runtime environment: 'development', 'production', or 'test'
NODE_ENV=development

# Express API Gateway HTTP port
PORT=4000

# Allowed CORS origins for browser web client requests
CORS_ORIGIN=http://localhost:5173

# =============================================================================
# 2. Document Storage & Filesystem
# =============================================================================
# Local filesystem directory for storing uploaded binary/text document payloads
STORAGE_DIR=./infrastructure/storage/documents

# =============================================================================
# 3. Authentication & Session Security (Phase 1)
# =============================================================================
# Secret key used for signing HMAC-SHA256 JWT access tokens (min 32 characters in production)
JWT_ACCESS_SECRET=dev_jwt_access_secret_replace_in_production_min_32_chars

# Access token time-to-live (e.g., '15m', '1h')
JWT_ACCESS_EXPIRY=15m

# Secret key used for signing HttpOnly refresh token cookies (min 32 characters in production)
COOKIE_SECRET=dev_cookie_signing_secret_replace_in_prod_min_32_chars

# Sliding refresh token session lifetime in days
REFRESH_TOKEN_EXPIRY_DAYS=7

# =============================================================================
# 4. Database (PostgreSQL 16 + pgvector)
# =============================================================================
# Credentials and port used by docker-compose.yml
POSTGRES_USER=mindvault
POSTGRES_PASSWORD=mindvault_dev_password
POSTGRES_DB=mindvault
POSTGRES_PORT=5432

# Prisma Client database connection URL (runtime query traffic; uses Neon pooled PgBouncer endpoint in production)
# Neon Production: postgresql://user:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
DATABASE_URL=postgresql://mindvault:mindvault_dev_password@localhost:5432/mindvault?schema=public

# Direct unpooled database connection URL (strictly used by Prisma CLI for migrations / schema updates)
# Neon Production: postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
# For local development without connection pooler, set identical to DATABASE_URL:
DIRECT_URL=postgresql://mindvault:mindvault_dev_password@localhost:5432/mindvault?schema=public

# =============================================================================
# 5. Cache & Background Job Queues (Redis 7 & BullMQ / Upstash)
# =============================================================================
# Upstash Redis host / port
REDIS_HOST=your-db-id.upstash.io
REDIS_PORT=6379

# Full Redis connection URL used by BullMQ worker, API queues, and graph lease fencing.
# Local Development (Default):
REDIS_URL=redis://localhost:6379
# Upstash Production (Render/Cloud Worker): rediss://default:<TOKEN>@your-db-id.upstash.io:6379
# NOTE: BullMQ mandates native TLS TCP connection (rediss://). Do NOT use Upstash REST URLs.

# Local Worker Safety Guard (§P0):
# Set to 'true' ONLY if you explicitly want a local development worker to connect to remote Redis.
# In development, the worker startup fails closed if REDIS_URL is remote and this is false.
DEV_ALLOW_REMOTE_REDIS=false

# Worker Queue Capability & Concurrency
# Local workstation: 'local' (isolated from cloud jobs). Cloud container: 'cloud'.
WORKER_TYPE=local
WORKER_CONCURRENCY=1

# Optional internal token for un-sanitized worker health telemetry via /api/health/worker
INTERNAL_DIAGNOSTICS_TOKEN=dev_diagnostics_token_optional

# =============================================================================
# 6. Web Frontend (Vite)
# =============================================================================
# Full API base URL (Vite dev server proxy dynamically routes /api to PORT or this origin)
VITE_API_BASE_URL=http://localhost:4000/api

# =============================================================================
# 7. Document Embeddings & Ingestion (Gemini Native)
# =============================================================================
# Active embedding provider: 'gemini' (default) or 'mock' (offline test)
EMBEDDING_PROVIDER=gemini

# Primary embedding model (generates 768-dimensional dense vectors via Matryoshka output)
EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Rate limiting controls for Google Gen AI Developer API
GEMINI_EMBEDDING_RPM_LIMIT=300
GEMINI_EMBEDDING_TPM_LIMIT=1000000

# =============================================================================
# 8. Generative RAG & Primary LLM Provider (Google Gemini)
# =============================================================================
# Active LLM provider: 'gemini' (default) or 'mock' (offline test)
LLM_PROVIDER=gemini

# Google AI Studio / Gemini API Key (Required for live generation, embeddings & KG extraction)
GEMINI_API_KEY=your_gemini_api_key_here

# Primary completion model for RAG response generation and Knowledge Graph extraction
GEMINI_MODEL=gemini-3.5-flash

# Request timeout in milliseconds for LLM generation calls
LLM_REQUEST_TIMEOUT=60000

# Maximum output tokens generated per answer
LLM_MAX_OUTPUT_TOKENS=1024

# Generation sampling temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.2

# =============================================================================
# 9. Knowledge Graph Extraction Engine
# =============================================================================
# Provider for entity/relation extraction: 'gemini' (default) or 'mock'
GRAPH_EXTRACTION_PROVIDER=gemini

# =============================================================================
# 11. Cross-Encoder Reranker Engine (Optional Advanced Retrieval)
# =============================================================================
# Optional external reranker HTTP endpoint (falls back to NoOpRerankerProvider if unset)
# RERANKER_ENDPOINT=http://localhost:8080/rerank
# RERANKER_API_KEY=your_reranker_api_key_here

# =============================================================================
# 12. Evaluation Benchmark Harness (Optional)
# =============================================================================
# Dedicated database URL for isolated evaluation benchmarks
# EVAL_DATABASE_URL=postgresql://mindvault:mindvault_dev_password@localhost:5433/mindvault_eval?schema=public
# EVAL_GENERATION_PROVIDER=gemini
