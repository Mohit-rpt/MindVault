# -----------------------------------------------------------------------------
# MindVault — Environment Configuration Template
# Copy this file to .env and adjust variables for your local setup.
# -----------------------------------------------------------------------------

# =============================================================================
# 1. Environment & Server Gateway
# =============================================================================
# Node runtime environment: 'development', 'production', or 'test'
NODE_ENV=development

# Express API Gateway HTTP port
PORT=4000

# Allowed CORS origins for browser web client requests
CORS_ORIGIN=http://localhost:5173

# =============================================================================
# 2. Document Storage & Filesystem
# =============================================================================
# Local filesystem directory for storing uploaded binary/text document payloads
STORAGE_DIR=./infrastructure/storage/documents

# =============================================================================
# 3. Authentication & Session Security (Phase 1)
# =============================================================================
# Secret key used for signing HMAC-SHA256 JWT access tokens (min 32 characters in production)
JWT_ACCESS_SECRET=dev_jwt_access_secret_replace_in_production_min_32_chars

# Access token time-to-live (e.g., '15m', '1h')
JWT_ACCESS_EXPIRY=15m

# Secret key used for signing HttpOnly refresh token cookies (min 32 characters in production)
COOKIE_SECRET=dev_cookie_signing_secret_replace_in_prod_min_32_chars

# Sliding refresh token session lifetime in days
REFRESH_TOKEN_EXPIRY_DAYS=7

# =============================================================================
# 4. Database (PostgreSQL 16 + pgvector)
# =============================================================================
# Credentials and port used by docker-compose.yml
POSTGRES_USER=mindvault
POSTGRES_PASSWORD=mindvault_dev_password
POSTGRES_DB=mindvault
POSTGRES_PORT=5432

# Prisma Client database connection URL (ensure host and port match POSTGRES_PORT)
DATABASE_URL=postgresql://mindvault:mindvault_dev_password@localhost:5432/mindvault?schema=public

# =============================================================================
# 5. Cache & Background Job Queues (Redis 7 & BullMQ)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379

# Full Redis connection URL used by BullMQ worker and cache managers
REDIS_URL=redis://localhost:6379

# Maximum concurrent document ingestion jobs processed per worker instance
WORKER_CONCURRENCY=5

# =============================================================================
# 6. Web Frontend (Vite)
# =============================================================================
# Full API base URL (Vite dev server proxy dynamically routes /api to PORT or this origin)
VITE_API_BASE_URL=http://localhost:4000/api

# =============================================================================
# 7. Document Embeddings & Ingestion (Phase 2 & 3)
# =============================================================================
# Ollama embedding model name (generates 768-dimensional dense vectors)
EMBEDDING_MODEL=nomic-embed-text

# =============================================================================
# 8. Generative RAG & Primary LLM Provider (Phase 4 & 5)
# =============================================================================
# Active LLM provider: 'ollama' (default local), 'gemini' (cloud), or 'mock' (offline test)
LLM_PROVIDER=ollama

# Base HTTP URL for local Ollama service
OLLAMA_BASE_URL=http://localhost:11434

# Primary completion model for RAG response generation
OLLAMA_GENERATION_MODEL=qwen3:0.6b

# Request timeout in milliseconds for LLM generation calls
LLM_REQUEST_TIMEOUT=60000

# Maximum output tokens generated per answer
LLM_MAX_OUTPUT_TOKENS=1024

# Generation sampling temperature (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.2

# =============================================================================
# 9. Knowledge Graph Extraction Engine (Phase 6)
# =============================================================================
# Provider for entity/relation extraction: 'ollama', 'gemini', or 'mock' (defaults to LLM_PROVIDER)
# GRAPH_EXTRACTION_PROVIDER=ollama

# Dedicated model for structured JSON graph extraction (defaults to OLLAMA_GENERATION_MODEL)
# OLLAMA_EXTRACTION_MODEL=qwen3:0.6b

# Extraction sampling temperature (defaults to 0.0 for strict JSON schema compliance)
# OLLAMA_EXTRACTION_TEMPERATURE=0.0

# Enable thinking/reasoning tokens during extraction (defaults to false)
# OLLAMA_EXTRACTION_THINK=false

# Dedicated timeout in milliseconds for graph extraction (defaults to LLM_REQUEST_TIMEOUT)
# OLLAMA_EXTRACTION_TIMEOUT_MS=60000

# =============================================================================
# 10. Google Gemini Cloud Provider (Optional)
# =============================================================================
# Required only if LLM_PROVIDER=gemini or GRAPH_EXTRACTION_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model identifier (defaults to gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash

# =============================================================================
# 11. Cross-Encoder Reranker Engine (Optional Advanced Retrieval)
# =============================================================================
# Optional external reranker HTTP endpoint (falls back to NoOpRerankerProvider if unset)
# RERANKER_ENDPOINT=http://localhost:8080/rerank
# RERANKER_API_KEY=your_reranker_api_key_here

# =============================================================================
# 12. Evaluation Benchmark Harness (Optional)
# =============================================================================
# Dedicated database URL for isolated evaluation benchmarks
# EVAL_DATABASE_URL=postgresql://mindvault:mindvault_dev_password@localhost:5433/mindvault_eval?schema=public
# EVAL_GENERATION_PROVIDER=gemini
