// MindVault Prisma Schema — PostgreSQL + pgvector
// Phase 1: Authentication & Workspace Management
// Phase 2: Document Ingestion Pipeline & Vector Knowledge Storage

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum DocumentStatus {
  UPLOADED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  DELETING
}

model User {
  id           String            @id @default(uuid())
  name         String
  email        String            @unique
  passwordHash String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  memberships  WorkspaceMember[]
  sessions     Session[]
  documents    Document[]
  chatSessions ChatSession[]

  @@map("users")
}

model Workspace {
  id        String            @id @default(uuid())
  name      String
  slug      String            @unique
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  members      WorkspaceMember[]
  documents    Document[]
  chunks       DocumentChunk[]
  chatSessions ChatSession[]
  chatMessages ChatMessage[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([userId])
  @@index([workspaceId])
  @@map("workspace_members")
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@map("sessions")
}

model Document {
  id                 String         @id @default(uuid())
  workspaceId        String
  uploadedById       String
  originalName       String
  mimeType           String
  extension          String
  sizeBytes          BigInt
  checksum           String
  storageKey         String
  status             DocumentStatus @default(UPLOADED)
  errorMessage       String?
  pageCount          Int?
  chunkCount         Int            @default(0)
  embeddingModel     String?
  embeddingDimension Int?
  metadata           Json           @default("{}")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  processedAt        DateTime?

  workspace          Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy         User           @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  chunks             DocumentChunk[]

  @@index([workspaceId])
  @@index([status])
  @@index([workspaceId, checksum])
  @@map("documents")
}

model DocumentChunk {
  id          String                      @id @default(uuid())
  documentId  String
  workspaceId String
  chunkIndex  Int
  content     String                      @db.Text
  tokenCount  Int
  pageStart   Int?
  pageEnd     Int?
  metadata    Json                        @default("{}")
  embedding    Unsupported("vector(768)")?
  searchVector Unsupported("tsvector")?
  createdAt    DateTime                    @default(now())

  document    Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  workspace   Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([workspaceId])
  @@index([documentId])
  @@map("document_chunks")
}

// Phase 5: Conversational RAG & Persistent Chat Sessions

enum ChatSessionStatus {
  ACTIVE
  ARCHIVED
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ChatMessageStatus {
  PENDING
  STREAMING
  COMPLETED
  FAILED
  CANCELLED
}

model ChatSession {
  id                   String            @id @default(uuid())
  workspaceId          String
  userId               String
  title                String
  status               ChatSessionStatus @default(ACTIVE)
  summary              String?           @db.Text
  summaryVersion       Int               @default(0)
  summarizedThroughSeq Int               @default(0)
  summaryUpdatedAt     DateTime?
  messageCount         Int               @default(0)
  lastMessageAt        DateTime          @default(now())
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  archivedAt           DateTime?

  workspace            Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages             ChatMessage[]

  @@index([workspaceId])
  @@index([userId])
  @@index([workspaceId, userId])
  @@index([workspaceId, lastMessageAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id             String            @id @default(uuid())
  sessionId      String
  workspaceId    String
  role           ChatMessageRole
  content        String            @db.Text
  status         ChatMessageStatus @default(PENDING)
  sequenceNumber Int
  citations      Json              @default("[]")
  metadata       Json              @default("{}")
  tokenEstimate  Int               @default(0)
  createdAt      DateTime          @default(now())
  completedAt    DateTime?

  session        ChatSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequenceNumber])
  @@index([sessionId])
  @@index([workspaceId])
  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

