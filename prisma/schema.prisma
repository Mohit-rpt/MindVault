// MindVault Prisma Schema — PostgreSQL + pgvector
// Phase 1: Authentication & Workspace Management
// Phase 2: Document Ingestion Pipeline & Vector Knowledge Storage

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum DocumentStatus {
  UPLOADED
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  DELETING
}

model User {
  id           String            @id @default(uuid())
  name         String
  email        String            @unique
  passwordHash String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  memberships  WorkspaceMember[]
  sessions     Session[]
  documents    Document[]
  chatSessions ChatSession[]

  @@map("users")
}

model Workspace {
  id        String            @id @default(uuid())
  name      String
  slug      String            @unique
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  members      WorkspaceMember[]
  documents    Document[]
  chunks       DocumentChunk[]
  chatSessions ChatSession[]
  chatMessages ChatMessage[]

  // Phase 6: Knowledge Graph
  graphEntities       GraphEntity[]
  graphEntityAliases  GraphEntityAlias[]
  graphRelations      GraphRelation[]
  chunkEntityMentions ChunkEntityMention[]
  relationEvidence    RelationEvidence[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([userId])
  @@index([workspaceId])
  @@map("workspace_members")
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@map("sessions")
}

model Document {
  id                 String         @id @default(uuid())
  workspaceId        String
  uploadedById       String
  originalName       String
  mimeType           String
  extension          String
  sizeBytes          BigInt
  checksum           String
  storageKey         String
  status             DocumentStatus @default(UPLOADED)
  errorMessage       String?
  pageCount          Int?
  chunkCount         Int            @default(0)
  embeddingModel     String?
  embeddingDimension Int?
  metadata           Json           @default("{}")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  processedAt        DateTime?

  workspace          Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy         User           @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  chunks             DocumentChunk[]

  @@unique([workspaceId, id])
  @@index([workspaceId])
  @@index([status])
  @@index([workspaceId, checksum])
  @@map("documents")
}

model DocumentChunk {
  id           String                      @id @default(uuid())
  documentId   String
  workspaceId  String
  chunkIndex   Int
  content      String                      @db.Text
  tokenCount   Int
  pageStart    Int?
  pageEnd      Int?
  metadata     Json                        @default("{}")
  embedding    Unsupported("vector(768)")?
  searchVector Unsupported("tsvector")?
  createdAt    DateTime                    @default(now())

  document     Document                    @relation(fields: [workspaceId, documentId], references: [workspaceId, id], onDelete: Cascade)
  workspace    Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Phase 6 Graph relations
  mentions     ChunkEntityMention[]
  evidence     RelationEvidence[]

  @@unique([documentId, chunkIndex])
  @@unique([workspaceId, id])
  @@unique([workspaceId, documentId, id])
  @@index([workspaceId])
  @@index([documentId])
  @@map("document_chunks")
}

// Phase 5: Conversational RAG & Persistent Chat Sessions

enum ChatSessionStatus {
  ACTIVE
  ARCHIVED
}

enum ChatMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum ChatMessageStatus {
  PENDING
  STREAMING
  COMPLETED
  FAILED
  CANCELLED
}

model ChatSession {
  id                   String            @id @default(uuid())
  workspaceId          String
  userId               String
  title                String
  status               ChatSessionStatus @default(ACTIVE)
  summary              String?           @db.Text
  summaryVersion       Int               @default(0)
  summarizedThroughSeq Int               @default(0)
  summaryUpdatedAt     DateTime?
  messageCount         Int               @default(0)
  lastMessageAt        DateTime          @default(now())
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  archivedAt           DateTime?

  workspace            Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages             ChatMessage[]

  @@index([workspaceId])
  @@index([userId])
  @@index([workspaceId, userId])
  @@index([workspaceId, lastMessageAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id             String            @id @default(uuid())
  sessionId      String
  workspaceId    String
  role           ChatMessageRole
  content        String            @db.Text
  status         ChatMessageStatus @default(PENDING)
  sequenceNumber Int
  citations      Json              @default("[]")
  metadata       Json              @default("{}")
  tokenEstimate  Int               @default(0)
  createdAt      DateTime          @default(now())
  completedAt    DateTime?

  session        ChatSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  workspace      Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([sessionId, sequenceNumber])
  @@index([sessionId])
  @@index([workspaceId])
  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

// =========================================================================
// Phase 6: Knowledge Graph & GraphRAG Models
// =========================================================================

enum EntityType {
  CONCEPT
  TECHNOLOGY
  ORGANIZATION
  PERSON
  LOCATION
  EVENT
  METRIC
  PRODUCT
  CUSTOM
  OTHER
}

model GraphEntity {
  id             String               @id @default(uuid())
  workspaceId    String               @map("workspace_id")
  canonicalName  String               @map("canonical_name")
  normalizedName String               @map("normalized_name")
  entityType     EntityType           @default(CONCEPT) @map("entity_type")
  description    String?              @db.Text
  embedding      Unsupported("vector(768)")?
  metadata       Json                 @default("{}")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  workspace       Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  aliases         GraphEntityAlias[]
  sourceRelations GraphRelation[]      @relation("SourceRelations")
  targetRelations GraphRelation[]      @relation("TargetRelations")
  mentions        ChunkEntityMention[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, normalizedName])
  @@index([workspaceId])
  @@index([workspaceId, normalizedName])
  @@index([workspaceId, entityType])
  @@map("graph_entities")
}

model GraphEntityAlias {
  id              String      @id @default(uuid())
  workspaceId     String      @map("workspace_id")
  entityId        String      @map("entity_id")
  alias           String      @db.VarChar(255)
  normalizedAlias String      @map("normalized_alias") @db.VarChar(255)
  aliasType       String      @default("SYNONYM") @map("alias_type") @db.VarChar(32)
  createdAt       DateTime    @default(now()) @map("created_at")

  workspace       Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entity          GraphEntity @relation(fields: [workspaceId, entityId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([workspaceId, normalizedAlias])
  @@index([workspaceId, normalizedAlias])
  @@index([workspaceId, entityId])
  @@map("graph_entity_aliases")
}

model GraphRelation {
  id             String               @id @default(uuid())
  workspaceId    String               @map("workspace_id")
  sourceEntityId String               @map("source_entity_id")
  targetEntityId String               @map("target_entity_id")
  relationType   String               @map("relation_type") @db.VarChar(64)
  description    String?              @db.Text
  weight         Float                @default(1.0)
  confidence     Float                @default(0.8)
  metadata       Json                 @default("{}")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  workspace      Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceEntity   GraphEntity          @relation("SourceRelations", fields: [workspaceId, sourceEntityId], references: [workspaceId, id], onDelete: Cascade)
  targetEntity   GraphEntity          @relation("TargetRelations", fields: [workspaceId, targetEntityId], references: [workspaceId, id], onDelete: Cascade)
  evidence       RelationEvidence[]

  @@unique([workspaceId, id])
  @@unique([workspaceId, sourceEntityId, targetEntityId, relationType])
  @@index([workspaceId])
  @@index([workspaceId, sourceEntityId])
  @@index([workspaceId, targetEntityId])
  @@index([workspaceId, relationType])
  @@map("graph_relations")
}

model ChunkEntityMention {
  id             String               @id @default(uuid())
  workspaceId    String               @map("workspace_id")
  chunkId        String               @map("chunk_id")
  entityId       String               @map("entity_id")
  mentionText    String               @map("mention_text") @db.VarChar(255)
  startOffset    Int?                 @map("start_offset")
  endOffset      Int?                 @map("end_offset")
  confidence     Float                @default(1.0)
  createdAt      DateTime             @default(now()) @map("created_at")

  workspace      Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunk          DocumentChunk        @relation(fields: [workspaceId, chunkId], references: [workspaceId, id], onDelete: Cascade)
  entity         GraphEntity          @relation(fields: [workspaceId, entityId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([chunkId])
  @@index([entityId])
  @@index([workspaceId, entityId, chunkId])
  @@map("chunk_entity_mentions")
}

model RelationEvidence {
  id             String               @id @default(uuid())
  workspaceId    String               @map("workspace_id")
  relationId     String               @map("relation_id")
  chunkId        String               @map("chunk_id")
  documentId     String               @map("document_id")
  evidenceText   String               @map("evidence_text") @db.Text
  confidence     Float                @default(0.85)
  createdAt      DateTime             @default(now()) @map("created_at")

  workspace      Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  relation       GraphRelation        @relation(fields: [workspaceId, relationId], references: [workspaceId, id], onDelete: Cascade)
  chunk          DocumentChunk        @relation(fields: [workspaceId, documentId, chunkId], references: [workspaceId, documentId, id], onDelete: Cascade)

  @@unique([workspaceId, relationId, chunkId])
  @@index([workspaceId])
  @@index([relationId])
  @@index([chunkId])
  @@index([documentId])
  @@map("relation_evidence")
}

