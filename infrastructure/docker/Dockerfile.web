# ==============================================================================
# MindVault Web Frontend — Multi-Stage Production Containerfile
# Builds Vite SPA and serves static assets via Nginx with reverse proxy
# ==============================================================================

FROM node:22-alpine AS builder
WORKDIR /app

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@12.16.1 --activate

# Copy monorepo manifests
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/config/package.json ./packages/config/
COPY packages/shared/package.json ./packages/shared/
COPY apps/web/package.json ./apps/web/

RUN pnpm install --frozen-lockfile

# Copy required sources
COPY packages/config/ ./packages/config/
COPY packages/shared/ ./packages/shared/
COPY apps/web/ ./apps/web/

# Build static bundle
RUN pnpm --filter @mindvault/shared build
RUN pnpm --filter @mindvault/web build

# Stage 2: Nginx Runner
FROM nginx:1.27-alpine AS runner

COPY --from=builder /app/apps/web/dist /usr/share/nginx/html
COPY infrastructure/docker/nginx.staging.conf /etc/nginx/nginx.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
