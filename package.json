{
  "name": "mindvault",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MindVault — AI-Powered Personal Knowledge Operating System",
  "packageManager": "pnpm@12.16.1",
  "license": "MIT",
  "scripts": {
    "dev:api": "pnpm --filter @mindvault/api dev",
    "dev:worker": "pnpm --filter @mindvault/worker dev",
    "dev:web": "pnpm --filter @mindvault/web dev",
    "build": "pnpm --filter @mindvault/shared build && pnpm --filter @mindvault/api build && pnpm --filter @mindvault/worker build && pnpm --filter @mindvault/companion build && pnpm --filter @mindvault/web build",
    "typecheck": "pnpm --filter @mindvault/shared exec tsc --noEmit && pnpm --filter @mindvault/api exec tsc --noEmit && pnpm --filter @mindvault/worker exec tsc --noEmit && pnpm --filter @mindvault/companion exec tsc --noEmit && pnpm --filter @mindvault/web exec tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:generate": "prisma generate --schema=prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema=prisma/schema.prisma",
    "retrieval:evaluate": "pnpm --filter @mindvault/api evaluate",
    "rag:evaluate": "pnpm --filter @mindvault/api evaluate:rag",
    "conversation:evaluate": "pnpm --filter @mindvault/api evaluate:conversation",
    "graph:evaluate": "pnpm --filter @mindvault/api evaluate:graph",
    "db:seed": "prisma db seed",
    "demo:check": "tsx scripts/verify-demo-environment.ts",
    "redis:smoke": "tsx scripts/test-redis-connection.ts",
    "test:e2e:worker": "tsx scripts/verify-api-worker-e2e.ts",
    "worker:preflight": "tsx scripts/verify-worker-preflight.ts",
    "worker:dev": "pnpm --filter @mindvault/worker dev",
    "worker:start": "pnpm --filter @mindvault/worker start",
    "companion:dev": "pnpm --filter @mindvault/companion dev",
    "companion:start": "pnpm --filter @mindvault/companion start"
  },
  "prisma": {
    "seed": "pnpm --filter @mindvault/api exec tsx ../../prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@mindvault/shared": "workspace:*",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.10.2",
    "bullmq": "^6.7.2",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "ioredis": "^6.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.0.5"
  }
}
